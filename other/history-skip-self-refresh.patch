+// A client redirect (e.g. <meta http-equiv="refresh">) back to the page that
+// triggered it is that page reloading itself. Recording each one would grow the
+// history, and its redirect chain, without bound for auto-refreshing pages.
+bool IsSelfRefresh(const HistoryAddPageArgs& request) {
+  return ui::PageTransitionIsMainFrame(request.transition) &&
+         (request.transition & ui::PAGE_TRANSITION_CLIENT_REDIRECT) &&
+         request.referrer == request.url;
+}
