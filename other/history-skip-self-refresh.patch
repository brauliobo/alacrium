+// A page refreshing itself with a client redirect must not add visits.
+TEST_F(HistoryBackendTest, SelfRefreshDoesNotAddVisits) {
+  ASSERT_TRUE(backend_.get());
+
+  GURL url("http://google.com/stats");
+  AddClientRedirect(GURL(), url, false, base::Time::Now(), nullptr, nullptr);
+  for (int i = 0; i < 3; ++i) {
+    AddClientRedirect(url, url, true, base::Time::Now(), nullptr, nullptr);
+  }
+
+  URLRow row;
+  URLID id = backend_->db()->GetRowForURL(url, &row);
+  VisitVector visits;
+  ASSERT_TRUE(backend_->db()->GetVisitsForURL(id, &visits));
+  EXPECT_EQ(1u, visits.size());
+  EXPECT_EQ(1, row.visit_count());
+  EXPECT_EQ(1, num_url_visited_notifications());
+}
